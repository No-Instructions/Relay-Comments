{
	"name": "obsidian-relay-comments",
	"version": "0.1.0",
	"description": "Relay-aware comments and suggestions for Obsidian Markdown notes.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs watch",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"check": "tsc -noEmit -skipLibCheck",
		"check:no-node": "tsc -noEmit -skipLibCheck -p tsconfig.no-node.json",
		"lint": "eslint src",
		"verify-release": "node scripts/verify-release.mjs",
		"release": "npm run lint && npm run build && npm run check:no-node && npm test && npm run verify-release",
		"test": "npm run test:unit",
		"test:unit": "jest",
		"test:integration": "python3 tests/integration/run.py",
		"version": "node scripts/version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"relay",
		"comments",
		"criticmarkup",
		"codemirror"
	],
	"author": "System 3",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@eslint/js": "^9.39.5",
		"@types/jest": "^29.5.14",
		"@types/node": "^16.11.6",
		"builtin-modules": "^3.3.0",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"globals": "^17.9.0",
		"jest": "^29.7.0",
		"obsidian": "^1.7.2",
		"ts-jest": "^29.4.11",
		"tslib": "^2.6.2",
		"typescript": "^5.4.5",
		"typescript-eslint": "^8.67.0"
	}
}
